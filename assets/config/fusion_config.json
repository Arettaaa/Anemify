{
  "version": "fusion_v1",
  "method": "product_decision_rule",
  "formula": "logit(p) = ln(p/(1-p)) dengan p di-clip ke [clip, 1-clip]; p_gabungan = sigmoid(logit(p_palm) + logit(p_konj) - logit(prior))",
  "prior": 0.6046287695584631,
  "clip": 1e-06,
  "models": {
    "palm": {
      "file": "palm_v3_fp32.tflite",
      "input": {
        "shape": [
          1,
          224,
          224,
          4
        ],
        "dtype": "float32",
        "channel_order": "RGBA",
        "range": "RGB 0..255, alpha 0 atau 255 (255 = ROI). TANPA normalisasi tambahan.",
        "how_to_make": "crop ROI telapak tangan (bagian tengah telapak, mengisi frame, seperti dataset), resize bilinear ke 224x224 tanpa mempertahankan rasio; alpha = 255 di seluruh gambar. Jika ada mask ROI: piksel di luar ROI diisi warna rata-rata ROI sebelum resize, alpha = mask (>127 -> 255, selain itu 0)"
      }
    },
    "konjungtiva": {
      "file": "konjungtiva_v3_fp32.tflite",
      "input": {
        "shape": [
          1,
          224,
          224,
          4
        ],
        "dtype": "float32",
        "channel_order": "RGBA",
        "range": "RGB 0..255, alpha 0 atau 255 (255 = ROI). TANPA normalisasi tambahan.",
        "how_to_make": "potong ke kotak pembatas ROI konjungtiva, isi piksel di luar ROI dengan warna rata-rata ROI (sebelum resize), resize bilinear ke 224x224 tanpa mempertahankan rasio; alpha = mask ROI di-resize lalu >127 -> 255, selain itu 0"
      }
    }
  },
  "categories": {
    "gabungan": {
      "method": "pdr",
      "low_max": 0.446,
      "high_min": 0.649,
      "high_rule": "presisi >= 0.85"
    },
    "palm_saja": {
      "method": "palm",
      "low_max": 0.474,
      "high_min": 0.702,
      "high_rule": "presisi >= 0.85"
    },
    "konjungtiva_saja": {
      "method": "konjungtiva",
      "low_max": 0.46,
      "high_min": 0.81,
      "high_rule": "presisi >= 0.85"
    }
  },
  "category_rule": "skor < low_max -> rendah; low_max <= skor < high_min -> perlu_perhatian; skor >= high_min -> tinggi",
  "labels": [
    {
      "key": "rendah",
      "name": "Risiko rendah",
      "message": "Tidak ditemukan tanda kuat anemia pada foto. Tetap periksa ke tenaga kesehatan jika ada gejala."
    },
    {
      "key": "perlu_perhatian",
      "name": "Perlu perhatian",
      "message": "Ada kemungkinan anemia. Disarankan pemeriksaan kadar hemoglobin (Hb)."
    },
    {
      "key": "tinggi",
      "name": "Risiko tinggi",
      "message": "Tanda anemia cukup kuat. Segera lakukan pemeriksaan kadar hemoglobin (Hb) di fasilitas kesehatan."
    }
  ],
  "which_thresholds": {
    "dua_foto_valid": "gabungan",
    "hanya_palm": "palm_saja",
    "hanya_konjungtiva": "konjungtiva_saja"
  },
  "targets": {
    "recall_low_max": 0.9,
