{
  "version": "fusion_v5",
  "method": "product_decision_rule",
  "formula": "logit(p) = ln(p/(1-p)) dengan p di-clip ke [clip, 1-clip]; p_gabungan = sigmoid(logit(p_palm) + logit(p_konj) - logit(prior))",
  "prior": 0.6064494380212062,
  "clip": 1e-06,
  "models": {
    "palm": {
      "file": "palm_v5_fp16.tflite",
      "version": "palm_v5",
      "chosen_model": "emb_reg",
      "input": {
        "shape": [
          1,
          224,
          224,
          4
        ],
        "dtype": "float32",
        "channel_order": "RGBA",
        "range": "RGB 0..255, alpha 0 atau 255 (255 = ROI). TANPA normalisasi tambahan. Sama dengan v3."
      }
    },
    "konjungtiva": {
      "file": "konjungtiva_v5_fp16.tflite",
      "version": "konjungtiva_v5",
      "chosen_model": "emb_reg",
      "input": {
        "shape": [
          1,
          224,
          224,
          4
        ],
        "dtype": "float32",
        "channel_order": "RGBA",
        "range": "RGB 0..255, alpha 0 atau 255 (255 = ROI). TANPA normalisasi tambahan. Sama dengan v3."
      }
    }
  },
  "categories": {
    "konjungtiva_saja": {
      "method": "konjungtiva",
      "low_max": 0.437,
      "high_min": 0.815,
      "high_rule": "presisi >= 0.85"
    },
    "palm_saja": {
      "method": "palm",
      "low_max": 0.45,
      "high_min": 0.722,
      "high_rule": "presisi >= 0.85"
    },
    "gabungan": {
      "method": "pdr",
      "low_max": 0.446,
      "high_min": 0.628,
      "high_rule": "presisi >= 0.85"
    }
  },
  "category_rule": "skor < low_max -> rendah; low_max <= skor < high_min -> perlu_perhatian; skor >= high_min -> tinggi",
  "labels": [
    {
      "key": "rendah",
      "name": "Risiko rendah",
      "message": "Tidak ditemukan tanda kuat anemia pada foto. Tetap periksa ke tenaga kesehatan jika ada gejala."
    },
    {
      "key": "perlu_perhatian",
      "name": "Perlu perhatian",
      "message": "Ada kemungkinan anemia. Disarankan pemeriksaan kadar hemoglobin (Hb)."
    },
    {
      "key": "tinggi",
      "name": "Risiko tinggi",
      "message": "Tanda anemia cukup kuat. Segera lakukan pemeriksaan kadar hemoglobin (Hb) di fasilitas kesehatan."
    }
  ],
  "which_thresholds": {
    "dua_foto_valid": "gabungan",
    "hanya_palm": "palm_saja",
    "hanya_konjungtiva": "konjungtiva_saja"
  },
  "targets": {
    "recall_low_max": 0.9,
    "ppv_high_min": 0.85,
    "fallback_spec": 0.9
  },
